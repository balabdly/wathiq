# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# مطلوب لـ /api/auth/login (ترحيل المصادقة)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Secret unique to this deployment (at least 32 random UTF-8 bytes); required for signed wathiq_access cookie
# Generate with: openssl rand -base64 48
WATHIQ_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes

# مطلوب لـ /super-admin (لوحة المشغّل)
SUPER_ADMIN_PASSWORD=your-strong-password
